# Ferry 环境变量示例（与 internal/config/config.go 保持 1:1 对齐）
# 本地开发可复制为 .env.local 后按需覆盖；.env.* 已由 .gitignore 忽略。

# ---------------------------------------------------------------------------
# 公共基础设施与日志配置（ferry-server / ferry-worker 共享）
# ---------------------------------------------------------------------------
FERRY_PG_DSN=postgres://ferry:ferry@localhost:5432/ferry?sslmode=disable
FERRY_KAFKA_BROKERS=localhost:9092
FERRY_KAFKA_READY_TOPIC=ferry.tasks.ready
FERRY_REDIS_ADDR=localhost:6379
FERRY_REDIS_PASSWORD=
FERRY_REDIS_DB=0
FERRY_LOG_LEVEL=info
FERRY_SLOW_SQL_THRESHOLD=200ms
FERRY_SHUTDOWN_DRAIN_TIMEOUT=25s

# ---------------------------------------------------------------------------
# ferry-server（API 网关与 OutboxRelay）
# ---------------------------------------------------------------------------
FERRY_HTTP_ADDR=:8080
FERRY_METRICS_ADDR=:2112
FERRY_KAFKA_READY_PARTITIONS=12
FERRY_DEFAULT_MAX_ATTEMPTS=1
FERRY_DEFAULT_TASK_WINDOW=24h
FERRY_OUTBOX_BATCH_SIZE=100
FERRY_OUTBOX_POLL_INTERVAL=500ms
FERRY_OUTBOX_BATCH_TIMEOUT=5s
FERRY_MAX_PAYLOAD_BYTES=1048576

# ---------------------------------------------------------------------------
# ferry-worker（Kafka 消费与 HTTP 出站投递）
# ---------------------------------------------------------------------------
FERRY_WORKER_PROBE_ADDR=:8082
FERRY_WORKER_METRICS_ADDR=:2113
FERRY_KAFKA_GROUP_ID=ferry-worker
FERRY_WORKER_CONCURRENCY=32
FERRY_EXECUTION_LOCK_GRACE=15s
FERRY_MAX_RESPONSE_SNIPPET_BYTES=1024

# ---------------------------------------------------------------------------
# chaos-receiver（本地验证用下游接收靶场）
# ---------------------------------------------------------------------------
FERRY_RECEIVER_ADDR=:8081
FERRY_RECEIVER_SECRET=
FERRY_RECEIVER_DEFAULT_STATUS=200
FERRY_RECEIVER_DEFAULT_DELAY=0s

# ---------------------------------------------------------------------------
# 真容器集成测试连接覆盖（可选，默认直连 deploy/docker-compose.yml 端口）
# ---------------------------------------------------------------------------
FERRY_TEST_PG_DSN=postgres://ferry:ferry@localhost:5432/ferry?sslmode=disable
FERRY_TEST_REDIS_ADDR=localhost:6379
FERRY_TEST_REDIS_DB=15
FERRY_TEST_REDIS_PASSWORD=
FERRY_TEST_KAFKA_BROKERS=localhost:9092
